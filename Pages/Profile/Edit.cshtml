@page
@model SystemManagementSystem.Pages.Profile.EditModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container-xl py-3">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Edit Profile</h1>
        <p class="text-muted mb-0">Update your username and email address.</p>
    </div>

    <section class="card rounded-4 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.UserName" class="form-label fw-semibold">Username</label>
                    <input asp-for="Input.UserName" class="form-control rounded-3" autocomplete="username" />
                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                    <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    <div class="form-text">
                        Changing your email requires confirmation. Your current email remains active until you confirm the new address.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        Save Changes
                    </button>
                    <a asp-page="/Profile/Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
