@page "{id:int}"
@model SystemManagementSystem.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete";
}
<div class="container my-4" style="max-width: 600px;">
    <!-- Navigation Back Link -->
    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>

    <!-- Main Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h3 class="fw-bold text-dark mb-0">Delete Product</h3>
            <p class="text-muted small mb-0">Are you sure you want to delete this product? This action cannot be undone.</p>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Product.ProductId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <!-- Product Name Field -->
                <div class="mb-3">
                    <label asp-for="Product.Name" class="form-label fw-semibold">Product Name</label>
                    <input asp-for="Product.Name" class="form-control" readonly />
                </div>

                <!-- Category Field -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <input value="@Model.Product.Category?.Name" class="form-control" readonly />
                </div>

                <!-- Selling Price Field -->
                <div class="mb-3">
                    <label asp-for="Product.SellingPrice" class="form-label fw-semibold">Selling Price</label>
                    <input asp-for="Product.SellingPrice" class="form-control" readonly />
                </div>

                <!-- Stock Quantity Field -->
                <div class="mb-3">
                    <label asp-for="Product.StockQuantity" class="form-label fw-semibold">Stock Quantity</label>
                    <input asp-for="Product.StockQuantity" class="form-control" readonly />
                </div>

                <!-- Description Field -->
                <div class="mb-4">
                    <label asp-for="Product.Description" class="form-label fw-semibold">Description</label>
                    <input asp-for="Product.Description" class="form-control" readonly />
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Delete Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
