@page
@model SystemManagementSystem.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Create Product";
}

<div class="container my-4" style="max-width: 600px;">

    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h3 class="fw-bold text-dark mb-0">Create New Product</h3>
            <p class="text-muted small mb-0">Selling price is automatically set to 30% above the purchase price.</p>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>


                <div class="mb-3">
                    <label asp-for="Product.Name" class="form-label fw-semibold">Product Name</label>
                    <input asp-for="Product.Name" class="form-control" placeholder="e.g. Wireless Mouse" required />
                    <span asp-validation-for="Product.Name" class="text-danger small"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Product.Description" class="form-label fw-semibold">Description</label>
                    <input asp-for="Product.Description" class="form-control" placeholder="e.g. Brief product description" />
                    <span asp-validation-for="Product.Description" class="text-danger small"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Product.CategoryId" class="form-label fw-semibold">Category</label>
                    <select asp-for="Product.CategoryId" asp-items="Model.CategoryList" class="form-select" required>
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Product.PurchasePrice" class="form-label fw-semibold">Purchase Price</label>
                        <input asp-for="Product.PurchasePrice" id="Product_PurchasePrice" class="form-control" type="number" step="0.01" min="0" value="0" />
                        <span class="form-text text-muted small">The cost per unit from the supplier.</span>
                    </div>


                    <div class="col-md-6 mb-3">
                        <label asp-for="Product.SellingPrice" class="form-label fw-semibold">Selling Price</label>
                        <input asp-for="Product.SellingPrice" id="Product_SellingPrice" class="form-control" type="number" step="0.01" min="0" value="0" readonly />
                        <span class="form-text text-muted small">Calculated automatically as purchase price + 30%.</span>
                    </div>

                </div>

                <p class="form-text text-muted mb-3">
                    Inventory quantities are recorded through purchase invoices.
                </p>


                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Product</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const purchasePriceInput = document.getElementById('Product_PurchasePrice');
                const sellingPriceInput = document.getElementById('Product_SellingPrice');
                if (!purchasePriceInput || !sellingPriceInput) return;

                const updateSellingPrice = function () {
                    const purchasePrice = Number.parseFloat(purchasePriceInput.value);
                    sellingPriceInput.value = Number.isFinite(purchasePrice)
                        ? (purchasePrice * 1.3).toFixed(2)
                        : '0.00';
                };

                purchasePriceInput.addEventListener('input', updateSellingPrice);
                updateSellingPrice();
            });
        </script>
    }
</div>
