@page
@model SystemManagementSystem.Pages.Account.VerifyEmailModel

@{
    ViewData["Title"] = "Verify Email";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-sm border-0 rounded-4 p-4 w-100" style="max-width: 420px;">

        <div class="text-center mb-4">
            <i class="bi bi-envelope-check fs-1 text-primary"></i>

            <h2 class="mt-3">Verify Your Email</h2>

            <p class="text-muted">
                We sent a verification code to your email.
                Please enter the code below.
            </p>
        </div>

        <form method="post" asp-page-handler="Verify">
            <input type="hidden" asp-for="Email" />

            <div class="form-floating mb-3">
                <input asp-for="Input.Code" class="form-control rounded-3 text-center" placeholder="Verification Code"
                       maxlength="6" inputmode="numeric" autocomplete="one-time-code" required />

                <label asp-for="Input.Code">
                    <i class="bi bi-shield-lock me-2"></i>
                    Verification Code
                </label>

                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-3 py-2">
                <i class="bi bi-check-circle me-2"></i>
                Verify Email
            </button>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted mb-0">
                Didn't receive the code?
            </p>

            <form method="post" asp-page-handler="ResendCode">
                <input type="hidden" asp-for="Email" />

                <button type="submit" class="btn btn-link p-0">
                    Resend Code
                </button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}