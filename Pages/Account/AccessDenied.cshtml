@page
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-slash-fill display-1"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
                <p class="text-muted mb-4">You do not have permission to access this resource or perform this action.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-3 px-4">
                        <i class="bi bi-arrow-left me-1"></i> Go Back
                    </a>
                    <a asp-page="/Index" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
