@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}


<section class="landing-hero" id="home">
    <div class="container-xl px-4">
        <div class="row align-items-center g-5">


            <div class="col-lg-6">
                <div class="hero-badge">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Business Management, Simplified
                </div>

                <h1 class="hero-title mb-3">
                    Run your business<br />
                    with <span>NOVERP</span>
                </h1>

                <p class="hero-subtitle text-muted">
                    Manage sales, inventory, purchases, and customers from a single powerful platform.
                    Built for speed, designed for clarity.
                </p>

                @if (!isAuthenticated)
                {
                    <div class="hero-actions">
                        <a asp-page="/Account/Login" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Get Started
                        </a>
                    </div>
                }
                else
                {
                    <div class="hero-actions">
                        <a asp-page="/Dashboard" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> View Dashboard
                        </a>
                    </div>
                }

                <div class="hero-trust mt-3">
                    <div class="hero-trust-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>No setup required</span>
                    </div>
                    <div class="hero-trust-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Role-based access</span>
                    </div>
                    <div class="hero-trust-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Real-time data</span>
                    </div>
                </div>
            </div>


            <div class="col-lg-6">
                <partial name="_DashboardPreview" />
            </div>

        </div>
    </div>
</section>


<section class="features-section" id="about">
    <div class="container-xl px-4">
        <div class="text-center mb-5">
            <span class="section-label">About NOVERP</span>
            <h2 class="section-title">One platform, complete control</h2>
            <p class="text-muted mt-2" style="max-width:480px; margin:0 auto;">
                NOVERP brings your sales, inventory, purchasing, and customer operations together in one clear,
                easy-to-manage workspace.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="feature-card">
                    <div class="feature-icon blue">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="feature-title">Sales Invoicing</div>
                    <p class="feature-desc">Create, manage, and print professional invoices. Track payment status and
                        customer transaction history effortlessly.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon green">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="feature-title">Inventory Management</div>
                        <p class="feature-desc">Monitor stock levels in real time. Get low-stock alerts before you run out
                            and maintain full product catalog control.</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="feature-card">
                            <div class="feature-icon purple">
                                <i class="bi bi-people"></i>
                            </div>
                            <div class="feature-title">Customer Management</div>
                            <p class="feature-desc">Keep a complete customer database. View purchase history, outstanding
                                balances, and manage relationships all in one place.</p>
                            </div>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <div class="feature-card">
                                <div class="feature-icon amber">
                                    <i class="bi bi-cart-check"></i>
                                </div>
                                <div class="feature-title">Purchase Invoices</div>
                                <p class="feature-desc">Manage supplier orders and purchase invoices. Track what you owe and keep
                                    your procurement records clean and organized.</p>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-4">
                                <div class="feature-card">
                                    <div class="feature-icon cyan">
                                        <i class="bi bi-credit-card"></i>
                                    </div>
                                    <div class="feature-title">Payment Tracking</div>
                                    <p class="feature-desc">Record payments against invoices, track outstanding balances, and get a
                                        clear picture of your cash flow at any time.</p>
                                    </div>
                                </div>

                                <div class="col-md-6 col-lg-4">
                                    <div class="feature-card">
                                        <div class="feature-icon rose">
                                            <i class="bi bi-shield-lock"></i>
                                        </div>
                                        <div class="feature-title">Role-Based Access</div>
                                        <p class="feature-desc">Separate admin and user roles with granular permissions. Keep sensitive data
                                            protected while giving your team what they need.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>


                        <section class="contact-section" id="contact">
                            <div class="container-xl px-4">
                                <div class="contact-card">
                                    <div class="contact-icon">
                                        <i class="bi bi-chat-dots"></i>
                                    </div>
                                    <span class="section-label">Contact Us</span>
                                    <h2 class="section-title">How can we help?</h2>
                                    <p class="text-muted mt-2 mb-4">
                                        For help with your NOVERP account or workspace, sign in and contact your system administrator.
                                    </p>
                                    <a asp-page="/Account/Login" class="btn btn-primary rounded-pill px-4 fw-semibold">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In for Support
                                    </a>
                                </div>
                            </div>
                        </section>
