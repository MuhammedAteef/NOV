@page "{id:int}"
@model SystemManagementSystem.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Edit";
}
<div class="container my-4" style="max-width: 600px;">

    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Customers
        </a>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h3 class="fw-bold text-dark mb-0">Update Customer</h3>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Customer.CustomerId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>


                <div class="mb-3">
                    <label asp-for="Customer.Name" class="form-label fw-semibold">Customer Name</label>
                    <input asp-for="Customer.Name" class="form-control" placeholder="e.g. John Smith" required />
                    <span asp-validation-for="Customer.Name" class="text-danger small"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Customer.Phone" class="form-label fw-semibold">Phone Number</label>
                    <input asp-for="Customer.Phone" class="form-control" placeholder="e.g. +1 555-0199" />
                    <span asp-validation-for="Customer.Phone" class="text-danger small"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Customer.Email" class="form-label fw-semibold">Email Address</label>
                    <input asp-for="Customer.Email" class="form-control" type="email" placeholder="e.g. john@example.com" />
                    <span asp-validation-for="Customer.Email" class="text-danger small"></span>
                </div>


                <div class="mb-4">
                    <label asp-for="Customer.Address" class="form-label fw-semibold">Address</label>
                    <textarea asp-for="Customer.Address" class="form-control" rows="3" placeholder="e.g. 123 Main Street, Suite 400"></textarea>
                    <span asp-validation-for="Customer.Address" class="text-danger small"></span>
                </div>


                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Update Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>
