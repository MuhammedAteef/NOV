@page
@model SystemManagementSystem.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Index";
}

<div class="container my-4">
    <!-- Header & Action Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">Customers</h2>
            <p class="text-muted small mb-0">Manage and view customer records</p>
        </div>
        <a asp-page="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Create New Customer</span>
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Customers Table Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Email</th>
                            <th scope="col">Address</th>
                            <th scope="col">Balance</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.allCustomers != null && Model.allCustomers.Any())
                        {
                            @foreach (var customer in Model.allCustomers)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@customer.CustomerId</td>
                                    <td class="fw-bold text-dark">@customer.Name</td>
                                    <td>@customer.Phone</td>
                                    <td>@customer.Email</td>
                                    <td>@customer.Address</td>
                                    <td>
                                        @(Model.CustomerTotals.TryGetValue(customer.CustomerId, out var total)
                                            ? total.ToString("N2")
                                            : "0.00")
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="Edit" asp-route-id="@customer.CustomerId"
                                               class="btn btn-sm btn-outline-primary" title="Edit Customer">
                                                Edit
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@customer.CustomerId"
                                               class="btn btn-sm btn-outline-danger" title="Delete Customer">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No customers found. Click <strong>Create New Customer</strong> to add one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
