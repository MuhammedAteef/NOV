@page "{id:int}"
@model SystemManagementSystem.Pages.PurchaseInvoices.ShowModel
@{
    ViewData["Title"] = $"Purchase Invoice #{Model.Invoice.PurchaseInvoiceId}";
    bool isDeleted = Model.Invoice.IsDeleted;
    decimal grandTotal = Model.LineItems.Sum(i => i.Quantity * i.UnitPrice);
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .receipt-wrapper { box-shadow: none !important; border: none !important; }
    }
</style>

<div class="container my-4" style="max-width: 780px;">


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 no-print" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 no-print" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Purchase Invoices
        </a>
        <div class="d-flex gap-2">
            @if (!isDeleted)
            {
                @if (Model.Remaining > 0)
                {
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#payRemainingModal">
                        <i class="bi bi-cash-coin me-1"></i> Pay Remaining ($@Model.Remaining.ToString("N2"))
                    </button>
                }
                <a asp-page="./Refund" asp-route-id="@Model.Invoice.PurchaseInvoiceId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-return-left me-1"></i> Refund to Supplier
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="./Delete" asp-route-id="@Model.Invoice.PurchaseInvoiceId"
                       class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Delete Invoice">
                        <i class="bi bi-trash-fill me-1" aria-hidden="true"></i> Delete
                    </a>
                }
            }
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-printer me-1"></i> Print
            </button>
        </div>
    </div>


    <div class="card shadow border-0 rounded-4 receipt-wrapper @(isDeleted ? "border border-danger" : "")">


        @if (isDeleted)
        {
            <div class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center"
                 style="top:0;left:0;pointer-events:none;z-index:0;opacity:.08;">
                <span style="font-size:8rem;font-weight:900;color:#DC2626;transform:rotate(-30deg);
                             white-space:nowrap;user-select:none;">DELETED</span>
            </div>
        }

        <div class="card-body p-5 position-relative" style="z-index:1;">


            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h3 class="fw-bold mb-0 text-dark">Purchase Invoice</h3>
                    <p class="text-muted mb-0 small">Official Purchase Record</p>
                </div>
                <div class="text-end">
                    @if (isDeleted)
                    {
                        <span class="status-badge out-of-stock fs-6 px-3 py-1.5">
                            🔴 Deleted
                        </span>
                    }
                    else if (Model.Remaining <= 0)
                    {
                        <span class="status-badge in-stock fs-6 px-3 py-1.5">
                            🟢 Fully Paid
                        </span>
                    }
                    else
                    {
                        <span class="status-badge low-stock fs-6 px-3 py-1.5">
                            🟡 Partial Payment
                        </span>
                    }
                </div>
            </div>

            <hr class="my-3" />


            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <p class="text-muted small fw-semibold text-uppercase mb-1">Invoice No.</p>
                    <p class="fw-bold mb-0 text-primary">#@Model.Invoice.PurchaseInvoiceId</p>
                </div>
                <div class="col-sm-4">
                    <p class="text-muted small fw-semibold text-uppercase mb-1">Invoice Date</p>
                    <p class="fw-bold mb-0">@Model.Invoice.InvoiceDate.ToString("dd MMM yyyy")</p>
                </div>
                <div class="col-sm-4">
                    <p class="text-muted small fw-semibold text-uppercase mb-1">Supplier</p>
                    <p class="fw-bold mb-0">@(Model.Invoice.Supplier?.Name ?? "Supplier #" + Model.Invoice.SupplierId)</p>
                </div>
                @if (isDeleted)
                {
                    <div class="col-sm-4">
                        <p class="text-muted small fw-semibold text-uppercase mb-1">Deleted On</p>
                        <p class="fw-bold mb-0 text-danger">@Model.Invoice.DeletedAt?.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                }
            </div>

            <hr class="my-3" />


            <div class="table-responsive">
                <table class="table align-middle mb-0">
                <thead>
                    <tr class="border-bottom border-2">
                        <th class="text-muted small fw-semibold text-uppercase">Product</th>
                        <th class="text-center text-muted small fw-semibold text-uppercase">Qty</th>
                        <th class="text-end text-muted small fw-semibold text-uppercase">Unit Price</th>
                        <th class="text-end text-muted small fw-semibold text-uppercase pe-0">Sub Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LineItems)
                    {
                        <tr class="@(item.IsDeleted ? "text-muted" : "")">
                            <td>
                                <span class="fw-semibold @(item.IsDeleted ? "text-decoration-line-through" : "")">
                                    @(item.Product?.Name ?? "Product #" + item.ProductId)
                                </span>
                                @if (item.Product?.Category != null)
                                {
                                    <br /><small class="text-muted">@item.Product.Category.Name</small>
                                }
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">$@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end pe-0 fw-semibold">
                                $@((item.Quantity * item.UnitPrice).ToString("N2"))
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>

            <hr class="my-3" />


            <div class="d-flex justify-content-end">
                <div style="min-width: 280px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Sub Total</span>
                        <span class="fw-semibold">$@grandTotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mb-2">
                        <span class="fw-bold fs-5 text-dark">Invoice Total</span>
                        <span class="fw-bold fs-5 text-primary">$@Model.Invoice.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between text-success mb-1">
                        <span class="fw-semibold">Total Paid</span>
                        <span class="fw-semibold">$@Model.TotalPaid.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between @(Model.Remaining > 0 ? "text-danger" : "text-success") border-top pt-1 fw-bold">
                        <span>Remaining Balance</span>
                        <span>$@Model.Remaining.ToString("N2")</span>
                    </div>
                </div>
            </div>


            @if (Model.Payments.Any())
            {
                <hr class="my-4" />
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Payment History</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="ps-3">Payment Date</th>
                                <th>Method</th>
                                <th>Reference / Intent</th>
                                <th class="text-end pe-3">Amount Paid</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pay in Model.Payments)
                            {
                                <tr>
                                    <td class="ps-3 small">@pay.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @(pay.PaymentMethod == "Card" ? "bg-info-subtle text-info border border-info-subtle" : "bg-success-subtle text-success border border-success-subtle")">
                                            @if (pay.PaymentMethod == "Card")
                                            {
                                                <i class="bi bi-credit-card me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-cash-stack me-1"></i>
                                            }
                                            @pay.PaymentMethod
                                        </span>
                                    </td>
                                    <td class="small text-muted">@(string.IsNullOrEmpty(pay.ReferenceNumber) ? "—" : pay.ReferenceNumber)</td>
                                    <td class="text-end pe-3 fw-bold text-success">$@pay.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.Refunds.Any())
            {
                <hr class="my-4" />
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-arrow-return-left me-2 text-primary"></i>Purchase Refund History
                </h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="ps-3">Refund Date</th>
                                <th>Returned Units</th>
                                <th>Reference</th>
                                <th class="text-end pe-3">Refund Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var refund in Model.Refunds)
                            {
                                <tr>
                                    <td class="ps-3 small">@refund.RefundDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@refund.Items.Sum(item => item.Quantity)</td>
                                    <td>@(string.IsNullOrWhiteSpace(refund.ReferenceNumber) ? "—" : refund.ReferenceNumber)</td>
                                    <td class="text-end pe-3 fw-semibold">$@refund.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }


            <div class="mt-5 pt-3 border-top text-center text-muted small">
                <p class="mb-0">Generated by <strong>Novix ERP — System Management</strong></p>
                <p class="mb-0">Printed on @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
            </div>

        </div>
    </div>
</div>


@if (!isDeleted && Model.Remaining > 0)
{
    <div class="modal fade" id="payRemainingModal" tabindex="-1" aria-labelledby="payRemainingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold" id="payRemainingModalLabel">
                        <i class="bi bi-cash-coin me-2"></i>Pay Remaining Balance
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="PayRemaining" id="payRemainingForm">
                    <input type="hidden" name="id" value="@Model.Invoice.PurchaseInvoiceId" />
                    <input type="hidden" asp-for="StripePaymentIntentId" id="modalStripePaymentIntentId" />
                    <input type="hidden" asp-for="PaymentRequestKey" />
                    @Html.AntiForgeryToken()

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold text-uppercase">Purchase Invoice</label>
                            <div class="fw-bold text-dark fs-5">#@Model.Invoice.PurchaseInvoiceId</div>
                        </div>

                        <div class="row g-3 mb-3 bg-light p-3 rounded-3 border">
                            <div class="col-6">
                                <label class="form-label text-muted small fw-semibold text-uppercase mb-1">Invoice Total</label>
                                <div class="fw-bold text-dark">$@Model.Invoice.TotalAmount.ToString("N2")</div>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small fw-semibold text-uppercase mb-1">Remaining Balance</label>
                                <div class="fw-bold text-danger fs-6">$@Model.Remaining.ToString("N2")</div>
                            </div>
                        </div>


                        <div class="mb-3">
                            <label asp-for="PayAmount" class="form-label fw-semibold">Payment Amount ($)</label>
                            <input asp-for="PayAmount" type="number" step="0.01" min="0.01" max="@Model.Remaining" id="modalPayAmount" class="form-control rounded-3" value="@Model.Remaining.ToString("F2")" required />
                            <small class="text-muted">You can pay full remaining or a partial amount.</small>
                        </div>


                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                            <select asp-for="PaymentMethod" id="modalPaymentMethod" class="form-select rounded-3" required onchange="toggleModalStripe(this.value)">
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                            </select>
                        </div>


                        <div class="mb-3" id="modalStripeCardContainer" data-stripe-key="@Model.StripePublishableKey" style="display:none;">
                            <label class="form-label fw-semibold">Stripe Card Details</label>
                            <div id="modal-card-element" class="form-control p-3 bg-white border rounded-3"></div>
                            
                            <div id="modal-card-alert" class="alert alert-danger d-flex align-items-center gap-2 mt-2 py-2 px-3 small" style="display:none;" role="alert">
                                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                                <span id="modal-card-error-msg" class="fw-semibold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold" id="confirmPayBtn">
                            <i class="bi bi-check-circle me-1"></i> Process Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script src="~/js/invoice-payment.js" asp-append-version="true"></script>
}
