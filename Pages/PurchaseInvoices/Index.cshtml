@page
@model SystemManagementSystem.Pages.PurchaseInvoices.IndexModel
@{
    ViewData["Title"] = "Purchase Invoices";
}

<div class="container-fluid px-0">
    <!-- Header & Action Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Purchase Invoices</h3>
            <p class="text-muted small mb-0">Manage supplier purchase orders, stock restocks, and payments.</p>
        </div>
        <div>
            <a asp-page="Create" class="btn btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> Create New Invoice
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FILTER & SEARCH CARD -->
    <div class="card rounded-4 border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" asp-for="SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by Invoice # or Supplier..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-calendar3 text-muted"></i>
                        </span>
                        <input type="date" asp-for="SelectedDate" class="form-control border-start-0 ps-0" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select asp-for="SupplierId" asp-items="Model.SupplierList" class="form-select">
                        <option value="">-- All Suppliers --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select asp-for="Status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Completed">Completed (Paid)</option>
                        <option value="UnCompleted">UnCompleted (Partial/Unpaid)</option>
                        <option value="Deleted">Deleted</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 px-3 w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary rounded-3 px-3 fw-semibold">
                        Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Purchase Invoices Table Card (Rounded-4) -->
    <div class="card rounded-4 border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-cart-check me-2 text-primary"></i>Purchase Records</h5>
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-1.5 rounded-pill">Total: @Model.allPurchaseInvoices.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th scope="col" class="ps-4">Invoice #</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Invoice Date</th>
                            <th scope="col">Total Amount</th>
                            <th scope="col">Paid Amount</th>
                            <th scope="col">Remaining Amount</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.allPurchaseInvoices != null && Model.allPurchaseInvoices.Any())
                        {
                            @foreach (var invoice in Model.allPurchaseInvoices)
                            {
                                bool deleted = invoice.IsDeleted;
                                <tr class="@(deleted ? "table-secondary" : "")">
                                    <td class="ps-4 fw-semibold text-primary">
                                        #@invoice.PurchaseInvoiceId
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @(invoice.Supplier?.Name ?? "Supplier #" + invoice.SupplierId)
                                    </td>
                                    <td class="text-muted">
                                        @invoice.InvoiceDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="fw-bold text-dark">
                                        $@invoice.TotalAmount.ToString("N2")
                                    </td>
                                    <td class="fw-bold text-success">
                                        $@invoice.PaidAmount.ToString("N2")
                                    </td>
                                    <td class="fw-bold @(invoice.RemainingAmount > 0 ? "text-danger" : "text-secondary")">
                                        $@invoice.RemainingAmount.ToString("N2")
                                    </td>
                                    <!-- Status column -->
                                    <td>
                                        @if (deleted)
                                        {
                                            <span class="status-badge out-of-stock">🔴 Deleted</span>
                                        }
                                        else
                                        {
                                            if(invoice.RemainingAmount == 0)
                                            {
                                                <span class="status-badge in-stock">🟢 Completed</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge low-stock">🟡 Partial</span>
                                            }
                                        }
                                    </td>
                                    <!-- Compact Action Icon Buttons -->
                                    <td class="text-end pe-4">
                                        <div class="btn-action-group">
                                            <a asp-page="Show" asp-route-id="@invoice.PurchaseInvoiceId" class="btn-action btn-action-view" title="View Purchase Receipt">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            @if (!deleted)
                                            {
                                                <a asp-page="Edit" asp-route-id="@invoice.PurchaseInvoiceId" class="btn-action btn-action-edit" title="Edit Invoice">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </a>
                                                <a asp-page="Delete" asp-route-id="@invoice.PurchaseInvoiceId" class="btn-action btn-action-delete" title="Delete Invoice">
                                                    <i class="bi bi-trash-fill"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No purchase invoices matching your filter parameters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
