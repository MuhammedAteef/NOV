@page "{id:int}"
@model SystemManagementSystem.Pages.SalesInvoices.EditModel
@{
    ViewData["Title"] = "Sales Return";
}

<div class="container my-4" style="max-width: 900px;">
    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Sales Invoices
        </a>
    </div>

    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-0">Make Sales Return</h2>
        <p class="text-muted small mb-0">Choose quantities to return. The original invoice will not be changed.</p>
    </div>

    <form method="post">
        <input type="hidden" asp-for="RequestKey" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger small mb-3"></div>
        }

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Invoice Details</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Invoice</dt>
                    <dd class="col-sm-9">#@Model.Invoice.SalesInvoiceId</dd>
                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">@Model.Invoice.Customer.Name</dd>
                    <dt class="col-sm-3">Invoice date</dt>
                    <dd class="col-sm-9">@Model.Invoice.InvoiceDate.ToString("d")</dd>
                </dl>
                <div class="mt-3">
                    <label asp-for="ReturnReason" class="form-label fw-semibold">Reason (optional)</label>
                    <textarea asp-for="ReturnReason" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>Invoice Items</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>Sold</th>
                                <th>Already returned</th>
                                <th>In stock</th>
                                <th style="width: 170px;">Return quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.ExistingItems.Count; index++)
                            {
                                var item = Model.ExistingItems[index];
                                var returnedQuantity =
                            Model.PreviouslyReturnedQuantities.GetValueOrDefault(item.SalesItemId);
                                var remainingQuantity = Math.Max(item.Quantity - returnedQuantity, 0);
                                var submittedQuantity = Model.LineItems?
                                    .FirstOrDefault(line => line.SalesItemId == item.SalesItemId)?.Quantity ?? 0;
                                <tr>
                                    <td class="ps-4">
                                        @item.Product.Name
                                        <input type="hidden" name="LineItems[@index].SalesItemId"
                                               value="@item.SalesItemId" />
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@returnedQuantity</td>
                                    <td>@item.Product.StockQuantity</td>
                                    <td>
                                        <input type="number" name="LineItems[@index].Quantity"
                                               class="form-control form-control-sm" min="0" max="@remainingQuantity"
                                               value="@submittedQuantity"
                                               aria-label="Return quantity for @item.Product.Name" />
                                        <small class="text-muted">Max: @remainingQuantity</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i> Create Sales Return
            </button>
        </div>
    </form>
</div>
