@page "{id:int}"
@model SystemManagementSystem.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit";
}
<div class="container my-4" style="max-width: 600px;">
    <!-- Navigation Back Link -->
    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Categories
        </a>
    </div>

    <!-- Main Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Category.CategoryId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <!-- Category Name Field -->
                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label fw-semibold">Category Name</label>
                    <input asp-for="Category.Name" class="form-control" placeholder="e.g. Acme Corporation" required />
                    <span asp-validation-for="Category.Name" class="text-danger small"></span>
                </div>

                <!-- Description Field -->
                <div class="mb-3">
                    <label asp-for="Category.Description" class="form-label fw-semibold">Description</label>
                    <input asp-for="Category.Description" class="form-control" placeholder="e.g. Details" />
                    <span asp-validation-for="Category.Description" class="text-danger small"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Save Categoty</button>
                </div>
            </form>
        </div>
    </div>
</div>

