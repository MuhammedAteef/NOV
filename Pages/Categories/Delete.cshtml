@page "{id:int}"
@model SystemManagementSystem.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete";
}
<div class="container my-4" style="max-width: 600px;">

    <div class="mb-3">
        <a asp-page="./Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Categories
        </a>
    </div>


    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-0">
            <h3 class="fw-bold text-dark mb-0">Delete Category</h3>
            <p class="text-muted small mb-0">Are you sure you want to delete this category? This action cannot be undone.</p>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Category.CategoryId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>


                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label fw-semibold">Category Name</label>
                    <input asp-for="Category.Name" class="form-control" readonly />
                </div>


                <div class="mb-4">
                    <label asp-for="Category.Description" class="form-label fw-semibold">Description</label>
                    <input asp-for="Category.Description" class="form-control" readonly />
                </div>


                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i> Delete Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
