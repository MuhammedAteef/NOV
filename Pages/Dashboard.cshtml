@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}


<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            @Model.GreetingMessage 👋
        </h2>
        <p class="text-muted small mb-0">
            Here's what's happening with your business operations today.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-white text-secondary border px-3 py-2 rounded-pill shadow-sm fw-normal">
            <i class="bi bi-calendar-event me-1 text-primary"></i> @DateTime.Now.ToString("dddd, MMMM d, yyyy")
        </span>
        <a asp-page="/SalesInvoices/Create"
           class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1">
            <i class="bi bi-plus-circle"></i> New Sale
        </a>
    </div>
</div>


<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">

    <div class="col">
        <div class="card rounded-4 border-0 shadow-sm card-hover p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Revenue Today</span>
                <div class="kpi-icon-box kpi-green">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">$@Model.RevenueToday.ToString("N2")</h3>
            <div class="d-flex align-items-center gap-1 text-success small">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Real-time Today</span>
            </div>
        </div>
    </div>


    <div class="col">
        <div class="card rounded-4 border-0 shadow-sm card-hover p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Products</span>
                <div class="kpi-icon-box kpi-blue">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalProducts</h3>
            <div class="text-muted small">Active in inventory</div>
        </div>
    </div>


    <div class="col">
        <div class="card rounded-4 border-0 shadow-sm card-hover p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Customers</span>
                <div class="kpi-icon-box kpi-purple">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalCustomers</h3>
            <div class="text-muted small">Registered clients</div>
        </div>
    </div>


    <div class="col">
        <div class="card rounded-4 border-0 shadow-sm card-hover p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Sales Invoices</span>
                <div class="kpi-icon-box kpi-amber">
                    <i class="bi bi-receipt"></i>
                </div>
            </div>
            <h3 class="fw-bold text-dark mb-1">@Model.TotalSalesInvoices</h3>
            <div class="text-muted small">Total completed sales</div>
        </div>
    </div>


    <div class="col">
        <div class="card rounded-4 border-0 shadow-sm card-hover p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Low Stock</span>
                <div class="kpi-icon-box @(Model.LowStockCount > 0 ? "kpi-rose" : "kpi-green")">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <h3 class="fw-bold @(Model.LowStockCount > 0 ? "text-danger" : "text-dark") mb-1">@Model.LowStockCount</h3>
            <div class="text-muted small">Items below threshold</div>
        </div>
    </div>
</div>


<div class="row g-4 mb-4">

    <div class="col-lg-8">
        <div class="card rounded-4 border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Sales
                    Invoices</h5>
                    <a asp-page="/SalesInvoices/Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th class="ps-4">Invoice #</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Total Amount</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentSales != null && Model.RecentSales.Any())
                                {
                                    @foreach (var sale in Model.RecentSales)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-semibold text-primary">#@sale.SalesInvoiceId</td>
                                            <td class="fw-medium">@(sale.Customer?.Name ?? "Walk-in Customer")</td>
                                            <td class="text-muted small">@sale.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                            <td class="fw-bold text-dark">$@sale.TotalAmount.ToString("N2")</td>
                                            <td class="text-end pe-4">
                                                <div class="btn-action-group">
                                                    <a asp-page="/SalesInvoices/Show" asp-route-id="@sale.SalesInvoiceId"
                                                       class="btn-action btn-action-view" title="View Receipt">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-page="/SalesInvoices/Show" asp-route-id="@sale.SalesInvoiceId"
                                                       class="btn-action btn-action-print" title="Print Invoice">
                                                        <i class="bi bi-printer"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No sales invoices recorded yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-lg-4">
            <div class="card rounded-4 border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Stock
                        Alerts</h5>
                        <a asp-page="/Products/Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Products</a>
                    </div>
                    <div class="card-body p-3">
                        @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var prod in Model.LowStockProducts)
                                {
                                    <div class="p-2.5 rounded-3 bg-light d-flex align-items-center justify-content-between border">
                                        <div>
                                            <div class="fw-semibold text-dark small">@prod.Name</div>
                                            <small class="text-muted">Price: $@prod.SellingPrice.ToString("N2")</small>
                                        </div>
                                        <div class="text-end">
                                            @if (prod.StockQuantity == 0)
                                            {
                                                <span class="status-badge out-of-stock">🔴 Out of Stock</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge low-stock">🟡 Low (@prod.StockQuantity)</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-check-circle-fill text-success display-6 mb-2"></i>
                                <p class="text-muted small mb-0">All stock levels are optimal!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
