@page
@model SystemManagementSystem.Pages.SalesInvoiceItems.IndexModel
@{
    ViewData["Title"] = "Index";
}

<div class="container my-4">
    <!-- Header & Action Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">Sales Invoice Items</h2>
            <p class="text-muted small mb-0">View all sales invoice line items</p>
        </div>
        <a asp-page="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Add New Item</span>
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Sales Invoice Items Table Card -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">ID</th>
                            <th scope="col">Invoice #</th>
                            <th scope="col">Product</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Unit Price</th>
                            <th scope="col">Sub Total</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.allSalesInvoiceItems != null && Model.allSalesInvoiceItems.Any())
                        {
                            @foreach (var item in Model.allSalesInvoiceItems)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@item.SalesItemId</td>
                                    <td>#@item.SalesInvoiceId</td>
                                    <td class="fw-bold text-dark">@item.Product?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("C")</td>
                                    <td>@item.SubTotal?.ToString("C")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="Edit" asp-route-id="@item.SalesItemId"
                                                   class="btn btn-sm btn-outline-primary" title="Edit Item">
                                                Edit
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@item.SalesItemId"
                                                   class="btn btn-sm btn-outline-danger" title="Delete Item">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No sales invoice items found. Click <strong>Add New Item</strong> to add one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
