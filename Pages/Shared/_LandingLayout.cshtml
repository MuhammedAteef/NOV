<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NOVERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SystemManagementSystem.styles.css" asp-append-version="true" />
</head>

<body class="landing-body">

    <!-- ── LANDING NAV ── -->
    <nav class="landing-nav">
        <div class="container-xl d-flex align-items-center justify-content-between py-3 px-4">
            <!-- Logo -->
            <a class="text-decoration-none d-flex align-items-center gap-2" asp-page="/Index">
                <div class="logo-brand-icon">
                    <i class="bi bi-layers-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark lh-1" style="font-size: 1.05rem;">NOV</div>
                    <small class="text-muted fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.05em;">ERP SYSTEM</small>
                </div>
            </a>

            <!-- Nav Links -->
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-outline-secondary btn-sm rounded-pill px-4 fw-semibold" asp-page="/Account/Login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </a>
                <a class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" asp-page="/Account/Register">
                    Get Started
                </a>
            </div>
        </div>
    </nav>

    <!-- ── PAGE CONTENT ── -->
    @RenderBody()

    <!-- ── LANDING FOOTER ── -->
    <footer class="landing-footer">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 py-4 px-4">
            <div class="d-flex align-items-center gap-2">
                <div class="logo-brand-icon" style="width:28px;height:28px;font-size:0.9rem;">
                    <i class="bi bi-layers-fill"></i>
                </div>
                <span class="fw-bold text-dark small">NOVERP</span>
                <span class="text-muted small">&bull; Version 1.0.0</span>
            </div>
            <div class="text-muted small">
                &copy; 2026 NOVERP. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
