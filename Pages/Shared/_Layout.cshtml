@{
    var currentPath = Context.Request.Path.Value ?? "";
    var isHomePage = currentPath == "/" || currentPath.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    bool isAdmin = User.IsInRole("Admin");

    string pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";

    var categoryMappings = new Dictionary<string, string>
    {
        { "/Products", "Inventory" },
        { "/Categories", "Inventory" },
        { "/StockHistory", "Inventory" },

        { "/SalesInvoices", "Sales" },
        { "/SalesInvoiceItems", "Sales" },
        { "/Customers", "Sales" },

        { "/PurchaseInvoices", "Purchases" },
        { "/PurchaseInvoiceItems", "Purchases" },
        { "/Suppliers", "Purchases" },

        { "/Payments", "Finance" },
        { "/Account", "Account" }
    };

    string categoryName = categoryMappings
        .FirstOrDefault(x => currentPath.Contains(x.Key, StringComparison.OrdinalIgnoreCase))
        .Value ?? "Home";

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NOVERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/SystemManagementSystem.styles.css" asp-append-version="true" />
</head>

<body class="app-shell">
    <partial name="_SiteNavbar" />


    <div class="app-wrapper">
        @if (!isHomePage && !currentPath.Contains("/Account"))
        {

            <button class="sidebar-reveal-toggle" id="sidebarRevealToggle" type="button" aria-label="Open navigation"
                    aria-controls="appSidebar" aria-expanded="false">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
            <button class="sidebar-backdrop" id="sidebarBackdrop" type="button" aria-label="Close navigation"
                    tabindex="-1"></button>
            <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation" aria-hidden="true">
                <div>

                    <div class="sidebar-heading-row">
                        <div class="sidebar-heading">Core Navigation</div>
                    </div>
                    <nav class="nav flex-column">
                        <a class="sidebar-nav-link @(currentPath == "/Dashboard" ? "active" : "")" asp-page="/Dashboard">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </nav>


                    <div class="sidebar-heading">Inventory & Catalog</div>
                    <nav class="nav flex-column">
                        <a class="sidebar-nav-link @(currentPath.Contains("/Products") ? "active" : "")"
                           asp-page="/Products/Index">
                            <i class="bi bi-box-seam"></i>
                            <span>Products</span>
                        </a>
                        @if (isAdmin)
                        {
                            <a class="sidebar-nav-link @(currentPath.Contains("/Categories") ? "active" : "")"
                               asp-page="/Categories/Index">
                                <i class="bi bi-tags"></i>
                                <span>Categories</span>
                            </a>
                            <a class="sidebar-nav-link @(currentPath.Contains("/StockHistory") ? "active" : "")"
                               asp-page="/StockHistory/Index">
                                <i class="bi bi-activity"></i>
                                <span>Stock History</span>
                            </a>
                        }
                    </nav>


                    <div class="sidebar-heading">Sales & Clients</div>
                    <nav class="nav flex-column">
                        <a class="sidebar-nav-link @(currentPath.Contains("/SalesInvoices") ? "active" : "")"
                           asp-page="/SalesInvoices/Index">
                            <i class="bi bi-cash-stack"></i>
                            <span>Sales Invoices</span>
                        </a>
                        <a class="sidebar-nav-link @(currentPath.Contains("/Customers") ? "active" : "")"
                           asp-page="/Customers/Index">
                            <i class="bi bi-people"></i>
                            <span>Customers</span>
                        </a>
                    </nav>


                    @if (isAdmin)
                    {
                        <div class="sidebar-heading">Purchases & Suppliers</div>
                        <nav class="nav flex-column">
                            <a class="sidebar-nav-link @(currentPath.Contains("/PurchaseInvoices") ? "active" : "")"
                               asp-page="/PurchaseInvoices/Index">
                                <i class="bi bi-cart-check"></i>
                                <span>Purchase Invoices</span>
                            </a>
                            <a class="sidebar-nav-link @(currentPath.Contains("/Suppliers") ? "active" : "")"
                               asp-page="/Suppliers/Index">
                                <i class="bi bi-truck"></i>
                                <span>Suppliers</span>
                            </a>
                        </nav>
                    }

                </div>
            </aside>
        }

        <main class="app-main-content">
            @if (!isHomePage)
            {
                <div class="breadcrumb-container">
                    <a asp-page="/Index"><i class="bi bi-house"></i> Home</a>
                    @if (categoryName != "Home")
                    {
                        <span class="breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
                        <span>@categoryName</span>
                    }
                    @if (!string.IsNullOrEmpty(pageTitle) && pageTitle != "Dashboard")
                    {
                        <span class="breadcrumb-separator"><i class="bi bi-chevron-right"></i></span>
                        <span class="fw-semibold text-dark">@pageTitle</span>
                    }
                </div>
            }

            @RenderBody()
        </main>
    </div>


    <partial name="_SiteFooter" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>